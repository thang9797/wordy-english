# Copy to .env and adjust.
# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://english:english@localhost:5432/english?schema=public"

# Better Auth: generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
